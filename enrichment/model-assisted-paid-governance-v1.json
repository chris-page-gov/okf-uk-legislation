  "cost_control": {
    "cap_usd": 250.0,
    "pricing_source": "A dated, hash-bound official pricing snapshot is required; no hard-coded or missing rate is accepted.",
    "request_upper_bound_formula": "(uncached_input_tokens * input_rate + cached_input_tokens * cached_input_rate + max_output_tokens * output_rate) / 1000000",
    "preflight_total_components": [
      "already spent",
      "availability probes",
      "every candidate calibration",
      "selected generator production",
      "review of every possible candidate assertion",
      "strongest-model escalation upper bound",
      "retry reserve"
    ],
    "atomic_reservation_invariant": "spent_usd + reserved_usd + next_request_upper_bound_usd <= 250.00",
    "retry_requires_new_reservation": true,
    "concurrent_inflight_reservations_count_toward_cap": true,
    "missing_cost_or_model_data": "fail-closed",
    "final_report": {
      "usd_total_required": true,
      "gbp_total_required": true,
      "dated_fx_source_rate_and_direction_required": true,
      "paid_run_accepted_assertion_denominator_required": true,
      "zero_accepted_assertions": "cost per accepted assertion is null with an explanation"
    }
  },
  "publication_boundary": {
    "candidate_output_is_not_a_relationship_assertion": true,
