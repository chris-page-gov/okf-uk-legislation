  "calibration_thresholds": {
    "structured_output_schema_validity": 1.0,
    "precision": 0.95,
    "evidence_support": 0.95,
    "selection": "Choose the lowest total measured and projected cost among models that pass every threshold on the same hash-bound calibration population.",
    "selection_cost_definition": "candidate comparison cost = observed calibration_cost_usd + projected post-calibration execution cost_usd; projected_total_cost_usd explicitly excludes the observed calibration charge",
    "schema_validity_definition": "Proportion of API responses conforming to the exact candidate response schema; input-fixture shape is not model-output schema validity.",
    "precision_definition": "Accepted candidate assertions matching independently governed gold assertions divided by all accepted candidate assertions.",
    "evidence_support_definition": "Accepted candidate assertions with a deterministic exact span in a hash-bound allowed evidence field and an independently accepted semantic entailment divided by all accepted candidate assertions."
  },
  "structured_output": {
    "api": "OpenAI Responses API text.format json_schema with strict true",
    "official_guidance": {
      "url": "https://developers.openai.com/api/docs/guides/structured-outputs#supported-schemas",
      "checked_on": "2026-07-26"
    },
    "api_facing_schemas": [
      "whole-law/schemas/model-enrichment-candidate.schema.json",
      "whole-law/schemas/model-enrichment-review.schema.json"
    ],
    "unsupported_composition_keywords_excluded": [
      "allOf",
      "not",
      "dependentRequired",
      "dependentSchemas",
      "if",
      "then",
      "else"
    ],
    "post_parse_validation": "The deterministic helper enforces kind-to-predicate mappings, exact frozen evidence spans and digests, duplicate suppression, canonical candidate binding, complete review index coverage, verdict/support consistency, threshold and cheapest-model selection, hash-bound strongest-model designation, hard-cap arithmetic, exact-model role separation, run count reconciliation and unique full-denominator terminal-outcome roots after strict parsing. An exact model is still admitted only after a successful append-only capability probe."
  },
  "model_roles": {
    "candidate_set": {
      "model_ids": [],
      "empty_until_observed_preflight": true,
      "admission": "An exact model ID is admitted only after the configured account returns a successful strict-structured-output capability probe. Every probe is an append-only paid attempt and counts toward the cap."
    },
    "generator": {
      "selection": "lowest-cost qualifying candidate",
      "exact_requested_and_returned_model_ids_required": true,
      "may_verify_own_output": false
    },
    "reviewer": {
      "selection": "separately configured qualifying reviewer",
      "must_pass_every_calibration_threshold": true,
      "must_differ_from_generator_exact_model_id": true,
      "separate_prompt_and_response_schema_required": true,
      "may_introduce_assertions": false,
      "reviews": "every proposed assertion"
    },
    "strongest": {
      "model_id": null,
      "empty_until_observed_preflight": true,
      "designation": "Before calibration, designate one exact available configured model as strongest using a hash-bound capability-ordering policy and hash-bound official model evidence. The selection receipt must bind both digests and the exact designated model. Never infer strongest from a model name at execution time.",
      "may_equal_reviewer": true,
      "may_equal_generator": false
    },
    "insufficient_separation": "If no exact reviewer or strongest model distinct from the generator is available, paid execution remains blocked."
  },
  "high_risk": {
    "low_confidence_threshold": 0.95,
    "flags": [
      "concept-link",
      "deterministic-disagreement",
      "entity-link",
      "evidence-field-mismatch",
      "jurisdiction-ambiguity",
      "known-collision-family",
      "low-confidence",
      "multi-topic",
      "non-title-evidence",
      "official-looking-target",
      "temporal-ambiguity",
      "uri-fallback-title"
    ],
    "escalate_when": [
      "any high-risk flag is present",
      "generator and reviewer disagree",
      "reviewer returns uncertainty",
      "deterministic validation finds a semantic or evidence mismatch"
    ],
    "deterministic_veto_is_final": true
  },
