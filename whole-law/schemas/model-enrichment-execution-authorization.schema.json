{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-uk-legislation/whole-law/schemas/model-enrichment-execution-authorization.schema.json",
  "title": "OKF optional direct-API model-enrichment execution authorization receipt v1",
  "description": "Optional future direct-API profile contract, not required for the current Codex/no-direct-API release. Secret-free evidence that a new explicit user decision transitioned the governance policy's default prohibition for one bounded paid run after a ready preflight.",
  "type": "object",
  "required": [
    "schema",
    "authorization_id",
    "run_id",
    "recorded_at",
    "snapshot_id",
    "cap_usd",
    "policy",
    "user_decision",
    "user_decision_evidence",
    "user_decision_evidence_sha256",
    "preflight_status",
    "ready_preflight_evidence",
    "ready_preflight_evidence_sha256",
    "transition_statement",
    "transition_statement_sha256",
    "external_attestation",
    "api_calls_permitted",
    "scope",
    "secret_material_recorded",
    "immutable"
  ],
  "properties": {
    "schema": {
      "const": "okf-model-enrichment-execution-authorization.v1"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^model-authorization-[a-z0-9][a-z0-9._-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "cap_usd": {
      "const": 250
    },
    "policy": {
      "$ref": "#/$defs/material"
    },
    "user_decision": {
      "enum": [
        "reuse-configured-api-key",
        "create-new-project-api-key"
      ]
    },
    "user_decision_evidence": {
      "$ref": "#/$defs/material"
    },
    "user_decision_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "preflight_status": {
      "const": "ready"
    },
    "ready_preflight_evidence": {
      "$ref": "#/$defs/material"
    },
    "ready_preflight_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "transition_statement": {
      "$ref": "#/$defs/material"
    },
    "transition_statement_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "external_attestation": {
      "$ref": "#/$defs/material"
    },
    "api_calls_permitted": {
      "const": true
    },
    "scope": {
      "const": "one governed model-assisted-paid-v2 run under the US$250 hard cap"
    },
    "secret_material_recorded": {
      "const": false
    },
    "immutable": {
      "const": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "material": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
