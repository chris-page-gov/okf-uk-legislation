{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-uk-legislation/whole-law/schemas/model-enrichment-attempt-ledger.schema.json",
  "title": "OKF model-enrichment attempt ledger v1",
  "description": "An integrity-bound complete inventory of append-only request attempts for one governed paid run.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "attempt_schema",
    "attempts",
    "counts",
    "usage",
    "cost_usd",
    "complete",
    "immutable"
  ],
  "properties": {
    "schema": {
      "const": "okf-model-enrichment-attempt-ledger.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attempt_schema": {
      "$ref": "#/$defs/material"
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "attempts",
        "api_calls",
        "succeeded",
        "failed"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "api_calls": {
          "type": "integer",
          "minimum": 1
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0,
      "maximum": 250
    },
    "complete": {
      "const": true
    },
    "immutable": {
      "const": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "material": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
