{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-uk-legislation/release-assurance/schemas/accessibility-assurance-receipt.schema.json",
  "title": "Frozen-candidate browser and accessibility assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "gate",
    "candidate",
    "archive",
    "explorer",
    "browsers",
    "keyboard_operable",
    "wcag",
    "materials",
    "assurance_boundary"
  ],
  "properties": {
    "schema": {
      "const": "okf-accessibility-assurance-receipt.v2"
    },
    "status": {
      "const": "passed"
    },
    "gate": {
      "const": "GATE-07"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "archive": {
      "$ref": "#/$defs/archive"
    },
    "explorer": {
      "$ref": "#/$defs/explorer"
    },
    "browsers": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          "chrome",
          "firefox",
          "webkit"
        ]
      }
    },
    "keyboard_operable": {
      "const": true
    },
    "wcag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "serious_violations",
        "critical_violations"
      ],
      "properties": {
        "standard": {
          "const": "WCAG 2.2 AA"
        },
        "serious_violations": {
          "const": 0
        },
        "critical_violations": {
          "const": 0
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/roleMaterial"
      },
      "contains": {
        "properties": {
          "role": {
            "const": "runtime"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "assurance_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "bundle_tree_sha256"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/chris-page-gov/okf-uk-legislation"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bundle_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "okf-uk-legislation-v0.3.0.tar.zst"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "explorer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/chris-page-gov/okf-explorer"
        },
        "tag": {
          "const": "v0.5.4"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "roleMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "runtime",
            "screenshot"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
