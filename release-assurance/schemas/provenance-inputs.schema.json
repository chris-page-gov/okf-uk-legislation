{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-uk-legislation/release-assurance/schemas/provenance-inputs.schema.json",
  "title": "OKF reproduction provenance inputs",
  "type": "object",
  "required": [
    "schema",
    "commit",
    "tree",
    "commit_time",
    "controller",
    "finalization_controller",
    "release_observation_controller",
    "pages_observation_controller",
    "pages_observation_schema",
    "assurance_receipt_controllers",
    "deployed_manifest_template",
    "deployed_probe_controller",
    "finalization_contract",
    "finalization_schemas",
    "explorer_runtime_provenance",
    "profile",
    "dependency_lock",
    "dependencies",
    "command_scripts",
    "commands",
    "environment",
    "network_policy"
  ],
  "properties": {
    "schema": {"const": "okf-reproduction-provenance-inputs.v2"},
    "commit": {"$ref": "#/$defs/gitObject"},
    "tree": {"$ref": "#/$defs/gitObject"},
    "commit_time": {"type": "string", "format": "date-time"},
    "controller": {
      "$ref": "#/$defs/reproductionControllerMaterial"
    },
    "finalization_controller": {
      "$ref": "#/$defs/finalizationControllerMaterial"
    },
    "release_observation_controller": {
      "$ref": "#/$defs/releaseObservationControllerMaterial"
    },
    "pages_observation_controller": {
      "$ref": "#/$defs/pagesObservationControllerMaterial"
    },
    "pages_observation_schema": {
      "$ref": "#/$defs/pagesObservationSchemaMaterial"
    },
    "assurance_receipt_controllers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/preRcAssuranceReceiptControllerMaterial"
        },
        {
          "$ref": "#/$defs/postRcAssuranceReceiptControllerMaterial"
        }
      ],
      "items": false
    },
    "deployed_manifest_template": {
      "$ref": "#/$defs/deployedManifestTemplateMaterial"
    },
    "deployed_probe_controller": {
      "$ref": "#/$defs/deployedProbeControllerMaterial"
    },
    "finalization_contract": {
      "$ref": "#/$defs/finalizationContractMaterial"
    },
    "finalization_schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/finalizationSchemaMaterial"}
    },
    "explorer_runtime_provenance": {
      "$ref": "#/$defs/explorerRuntimeProvenance"
    },
    "profile": {"$ref": "#/$defs/profileMaterial"},
    "dependency_lock": {"$ref": "#/$defs/dependencyLockMaterial"},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "command_scripts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/material"}
    },
    "required_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requiredReceipt"}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "environment": {"$ref": "#/$defs/environment"},
    "network_policy": {"$ref": "#/$defs/networkPolicy"}
  },
  "additionalProperties": false,
  "$defs": {
    "gitObject": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "material": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "reproductionControllerMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"const": "scripts/reproduce_release_candidate.py"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "finalizationControllerMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"const": "scripts/finalize_release_candidate.py"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "releaseObservationControllerMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "scripts/capture_github_release_observation.py"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "pagesObservationControllerMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "scripts/capture_github_pages_observation.py"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "pagesObservationSchemaMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "release-assurance/schemas/github-pages-observation.schema.json"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "preRcAssuranceReceiptControllerMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "scripts/build_pre_rc_assurance_receipts.py"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "postRcAssuranceReceiptControllerMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "scripts/build_post_rc_assurance_receipts.py"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "deployedManifestTemplateMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "release-assurance/deployed-entrypoints-manifest.json"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "deployedProbeControllerMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "scripts/probe_deployed_entrypoints.py"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "finalizationContractMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "release-assurance/external-finalization-contract.json"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "finalizationSchemaMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^release-assurance/schemas/[^/\\\\]+\\.schema\\.json$"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "explorerRuntimeProvenance": {
      "type": "object",
      "required": ["runner", "site_assembly", "pages"],
      "properties": {
        "runner": {
          "type": "object",
          "required": ["path", "bytes", "sha256"],
          "properties": {
            "path": {
              "const": "apps/okf-explorer/scripts/run_legislation_runtime_acceptance.mjs"
            },
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "site_assembly": {
          "type": "object",
          "required": ["app_manifest_module", "assembler", "verifier"],
          "properties": {
            "app_manifest_module": {
              "$ref": "#/$defs/explorerAppManifestModuleMaterial"
            },
            "assembler": {
              "$ref": "#/$defs/explorerSiteAssemblerMaterial"
            },
            "verifier": {
              "$ref": "#/$defs/explorerAssembledSiteVerifierMaterial"
            }
          },
          "additionalProperties": false
        },
        "pages": {
          "type": "object",
          "required": [
            "workflow_path",
            "workflow_bytes",
            "workflow_sha256",
            "run_id",
            "run_attempt",
            "commit",
            "artifact_id",
            "artifact_name",
            "artifact_zip",
            "artifact_tar",
            "build_manifest",
            "build_index",
            "build_tree"
          ],
          "properties": {
            "workflow_path": {
              "const": ".github/workflows/pages.yml"
            },
            "workflow_bytes": {"type": "integer", "minimum": 1},
            "workflow_sha256": {"$ref": "#/$defs/sha256"},
            "run_id": {"type": "integer", "minimum": 1},
            "run_attempt": {"type": "integer", "minimum": 1},
            "commit": {"$ref": "#/$defs/gitObject"},
            "artifact_id": {"type": "integer", "minimum": 1},
            "artifact_name": {"type": "string", "minLength": 1},
            "artifact_zip": {"$ref": "#/$defs/artifactSeal"},
            "artifact_tar": {"$ref": "#/$defs/artifactSeal"},
            "build_manifest": {
              "$ref": "#/$defs/explorerBuildManifestMaterial"
            },
            "build_index": {
              "$ref": "#/$defs/explorerBuildIndexMaterial"
            },
            "build_tree": {
              "$ref": "#/$defs/explorerBuildTree"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "explorerAppManifestModuleMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "apps/okf-explorer/scripts/app_build_manifest.mjs"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "explorerSiteAssemblerMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"const": "scripts/build_site.py"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "explorerAssembledSiteVerifierMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "apps/okf-explorer/scripts/verify_assembled_site.mjs"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "artifactSeal": {
      "type": "object",
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "explorerBuildManifestMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "explorer-build/okf-explorer-build-manifest.json"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "explorerBuildIndexMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"const": "explorer-build/index.html"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "explorerBuildTree": {
      "type": "object",
      "required": ["algorithm", "files", "sha256"],
      "properties": {
        "algorithm": {
          "const": "sha256-canonical-json-materials-v1"
        },
        "files": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "computed_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "profileMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "const": "release-assurance/reproduction-profile.json"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "dependencyLockMaterial": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"const": "requirements-validation.txt"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["name", "required", "installed", "matches"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "required": {"type": "string", "minLength": 1},
        "installed": {"type": "string", "minLength": 1},
        "matches": {"const": true}
      },
      "additionalProperties": false
    },
    "requiredReceipt": {
      "type": "object",
      "required": [
        "id",
        "schema",
        "material",
        "assertions",
        "status"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "material": {"$ref": "#/$defs/material"},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "status": {"const": "passed"}
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["pointer", "passed"],
      "properties": {
        "pointer": {"type": "string", "pattern": "^/"},
        "equals": true,
        "equals_pointer": {"type": "string", "pattern": "^/"},
        "passed": {"const": true}
      },
      "oneOf": [
        {
          "required": ["equals"],
          "not": {"required": ["equals_pointer"]}
        },
        {
          "required": ["equals_pointer"],
          "not": {"required": ["equals"]}
        }
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "index",
        "category",
        "argv",
        "exit_code",
        "log",
        "log_identity_note"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "category": {
          "enum": ["build_commands", "validation_commands"]
        },
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "exit_code": {"const": 0},
        "log": {
          "type": "string",
          "pattern": "^logs/[0-9]{2,}-[^/\\\\]+\\.log$"
        },
        "log_identity_note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "zstandard",
        "source_date_epoch",
        "timezone",
        "locale",
        "credentials_inherited",
        "diagnostic_logs_identity_bearing",
        "network_guard"
      ],
      "properties": {
        "python": {"$ref": "#/$defs/python"},
        "zstandard": {"$ref": "#/$defs/zstandardEnvironment"},
        "source_date_epoch": {"const": 0},
        "timezone": {"const": "UTC"},
        "locale": {"const": "C"},
        "credentials_inherited": {"const": false},
        "diagnostic_logs_identity_bearing": {"const": false},
        "network_guard": {
          "type": "object",
          "required": ["kind", "sha256"],
          "properties": {
            "kind": {
              "const": "python-sitecustomize-socket-and-cli-guard"
            },
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "python": {
      "type": "object",
      "required": ["major", "minor", "micro"],
      "properties": {
        "major": {"type": "integer", "minimum": 0},
        "minor": {"type": "integer", "minimum": 0},
        "micro": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "zstandardEnvironment": {
      "type": "object",
      "required": [
        "distribution",
        "version",
        "module_version",
        "level",
        "threads"
      ],
      "properties": {
        "distribution": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "module_version": {"type": "string", "minLength": 1},
        "level": {"type": "integer"},
        "threads": {"const": 0}
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "dependency_installation_during_run",
        "build_commands_are_offline",
        "credentials_inherited",
        "python_socket_guard",
        "network_cli_guard"
      ],
      "properties": {
        "dependency_installation_during_run": {"const": false},
        "build_commands_are_offline": {"const": true},
        "credentials_inherited": {"const": false},
        "python_socket_guard": {"const": true},
        "network_cli_guard": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
