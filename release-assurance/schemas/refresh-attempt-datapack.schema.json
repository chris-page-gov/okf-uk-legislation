{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-uk-legislation/release-assurance/schemas/refresh-attempt-datapack.schema.json",
  "title": "Immutable OKF refresh-attempt datapack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_id",
    "observed_at",
    "result",
    "snapshot",
    "chunks",
    "counts",
    "immutable"
  ],
  "properties": {
    "schema": {
      "const": "okf-refresh-attempt-datapack.v1"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "enum": [
        "no-drift-observed",
        "drift-detected"
      ]
    },
    "snapshot": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "const": "data/observation.json"
          },
          "media_type": {
            "const": "application/json"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probes",
        "passed",
        "drift",
        "failed",
        "unavailable",
        "violations"
      ],
      "properties": {
        "probes": {
          "const": 5
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "drift": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "violations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "immutable": {
      "const": true
    }
  }
}
