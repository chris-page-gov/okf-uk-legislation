    },
    "generatedAt": {
      "@id": "prov:generatedAtTime",
      "@type": "xsd:dateTime"
    },
    "license": {
      "@id": "dcterms:license",
      "@type": "@id"
    },
    "authorityClass": {
      "@id": "okflaw:authorityClass",
      "@type": "@id"
    },
