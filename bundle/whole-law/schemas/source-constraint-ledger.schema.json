{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-uk-legislation/whole-law/schemas/source-constraint-ledger.schema.json",
  "title": "OKF source constraint ledger v1",
  "type": "object",
  "required": ["schema", "generated_at", "constraints"],
  "properties": {
    "schema": {"const": "okf-source-constraint-ledger.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_id", "kind", "trigger", "effect", "mitigation", "owner", "escalation_state"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["fair-use", "licence", "authentication", "rate-limit", "robots", "privacy", "availability", "hosting"]},
          "trigger": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "minLength": 1},
          "mitigation": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "escalation_state": {"enum": ["recorded", "mitigated", "escalated", "resolved", "accepted-prototype-risk"]}
        }
      }
    }
  }
}

