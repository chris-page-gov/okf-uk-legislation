{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/okf/whole-law/coverage-ledger.schema.json",
  "title": "Whole-Law OKF coverage ledger",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "okf-whole-law-coverage-ledger.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "dimensions",
        "coverage_status",
        "denominator",
        "access",
        "evidence",
        "assessed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^COV-[A-Z0-9-]+$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^SRC[0-9]{3}$"
        },
        "dimensions": {
          "type": "object",
          "required": [
            "jurisdiction",
            "source_class",
            "issuing_institution",
            "document_type",
            "time_period",
            "version_state",
            "update_frequency",
            "availability"
          ],
          "properties": {
            "jurisdiction": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              }
            },
            "source_class": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string",
                "pattern": "^SC[0-9]{2}$"
              }
            },
            "issuing_institution": {
              "type": "string"
            },
            "court_or_tribunal": {
              "type": [
                "string",
                "null"
              ]
            },
            "document_type": {
              "type": "string"
            },
            "time_period": {
              "type": "object",
              "properties": {
                "from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            "version_state": {
              "enum": [
                "current",
                "historical",
                "all-published",
                "point-in-time",
                "draft",
                "mixed",
                "unknown"
              ]
            },
            "update_frequency": {
              "type": "string"
            },
            "availability": {
              "type": "object",
              "required": [
                "machine_readable",
                "human_readable"
              ],
              "properties": {
                "machine_readable": {
                  "enum": [
                    "complete",
                    "partial",
                    "none",
                    "unknown",
                    "restricted"
                  ]
                },
                "human_readable": {
                  "enum": [
                    "complete",
                    "partial",
                    "none",
                    "unknown",
                    "restricted"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        "coverage_status": {
          "enum": [
            "complete against official enumerated source",
            "partially complete",
            "discovery-only",
            "metadata-only",
            "progressively resolved",
            "documented but inaccessible",
            "access-restricted",
            "licence-restricted",
            "unavailable digitally",
            "unknown or not yet researched"
          ]
        },
        "denominator": {
          "type": "object",
          "required": [
            "basis",
            "value",
            "unit",
            "official",
            "source_url",
            "as_of"
          ],
          "properties": {
            "basis": {
              "enum": [
                "official-enumeration",
                "official-declared-boundary",
                "official-published-count",
                "publisher-catalogue",
                "derived-sitemap-or-feed",
                "contractual-dataset",
                "none-known"
              ]
            },
            "value": {
              "type": [
                "integer",
                "number",
                "null"
              ],
              "minimum": 0
            },
            "unit": {
              "type": "string"
            },
            "official": {
              "type": "boolean"
            },
            "source_url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "as_of": {
              "type": "string",
              "format": "date"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "numerator": {
          "type": "object",
          "required": [
            "value",
            "unit",
            "calculation"
          ],
          "properties": {
            "value": {
              "type": [
                "integer",
                "number",
                "null"
              ],
              "minimum": 0
            },
            "unit": {
              "type": "string"
            },
            "calculation": {
              "type": "string"
            },
            "deduplication_rule": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "percentage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "access": {
          "type": "object",
          "required": [
            "status",
            "tested_at",
            "method"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified working",
                "documented but not tested",
                "authenticated or restricted",
                "deprecated",
                "unavailable",
                "inferred"
              ]
            },
            "tested_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "method": {
              "type": "string"
            },
            "http_status": {
              "type": [
                "integer",
                "null"
              ]
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url",
              "claim"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "claim": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "description",
              "status"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "enum": [
                  "open",
                  "resolved",
                  "accepted-risk"
                ]
              },
              "resolution": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "assessed_by": {
          "type": "string"
        },
        "next_review_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
