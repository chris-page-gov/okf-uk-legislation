{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/okf/whole-law/answer-schema.json",
  "title": "Whole-Law OKF legal answer",
  "type": "object",
  "required": [
    "question",
    "scope",
    "answer",
    "propositions",
    "coverage",
    "uncertainty",
    "escalation"
  ],
  "properties": {
    "question": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "jurisdiction",
        "legal_date",
        "task_id"
      ],
      "properties": {
        "jurisdiction": {
          "type": [
            "string",
            "array"
          ]
        },
        "legal_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "pattern": "^T[0-9]{2}$"
        },
        "facts_assumed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "answer": {
      "type": "string"
    },
    "propositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "assertion_layer",
          "authority_class",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "assertion_layer": {
            "enum": [
              "source-text",
              "normalised-metadata",
              "extracted",
              "inferred",
              "synthesised",
              "expert-reviewed"
            ]
          },
          "authority_class": {
            "enum": [
              "binding-authority",
              "persuasive-authority",
              "procedural-material",
              "delegated-administrative-rules",
              "official-guidance",
              "history",
              "legal-service-information",
              "contextual-material"
            ]
          },
          "legal_force": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "canonical_url",
                "passage",
                "retrieved_at"
              ],
              "properties": {
                "source_id": {
                  "pattern": "^SRC[0-9]{3}$"
                },
                "canonical_url": {
                  "format": "uri"
                },
                "work_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "expression_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "manifestation_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "passage": {
                  "type": "object",
                  "required": [
                    "selector",
                    "faithful_extract"
                  ],
                  "properties": {
                    "selector": {
                      "type": "object"
                    },
                    "faithful_extract": {
                      "type": "string"
                    },
                    "source_hash": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "retrieved_at": {
                  "format": "date-time"
                },
                "version_context": {
                  "type": "object"
                },
                "licence": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "sources_searched",
        "sources_skipped",
        "coverage_assertion_ids"
      ],
      "properties": {
        "sources_searched": {
          "type": "array",
          "items": {
            "pattern": "^SRC[0-9]{3}$"
          }
        },
        "sources_skipped": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "coverage_assertion_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "escalation": {
      "type": "object",
      "required": [
        "required",
        "reasons"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_reviewer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
