{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-uk-legislation/release-assurance/schemas/explorer-runtime-receipt.schema.json",
  "title": "Frozen-candidate Explorer runtime acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "measured_at",
    "status",
    "candidate",
    "explorer",
    "runtime",
    "cross_engine",
    "accessibility",
    "performance",
    "integrity",
    "scope",
    "runner",
    "inputs",
    "outputs",
    "gates",
    "browsers",
    "failures",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "okf-explorer-runtime-acceptance.v2"
    },
    "measured_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "passed"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "explorer": {
      "$ref": "#/$defs/explorer"
    },
    "runtime": {
      "$ref": "#/$defs/summaryContainer"
    },
    "cross_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required",
        "completed"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "required": {
          "$ref": "#/$defs/browserSet"
        },
        "completed": {
          "$ref": "#/$defs/browserSet"
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "serious_or_critical_total",
        "browsers"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "serious_or_critical_total": {
          "const": 0
        },
        "browsers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "browser",
              "run_status",
              "serious_or_critical"
            ],
            "properties": {
              "browser": {
                "enum": [
                  "chrome",
                  "firefox",
                  "webkit"
                ]
              },
              "run_status": {
                "const": "passed"
              },
              "serious_or_critical": {
                "const": 0
              }
            }
          }
        }
      }
    },
    "performance": {
      "$ref": "#/$defs/summaryContainer"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "checks"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "summary": {
          "$ref": "#/$defs/passSummary"
        },
        "checks": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "$ref": "#/$defs/material"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_root",
        "federation_descriptor",
        "legislation_descriptor",
        "explorer_build"
      ],
      "properties": {
        "bundle_root": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "federation_descriptor": {
          "$ref": "#/$defs/material"
        },
        "legislation_descriptor": {
          "$ref": "#/$defs/material"
        },
        "explorer_build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "manifest",
            "index",
            "files",
            "sha256",
            "algorithm",
            "materials"
          ],
          "properties": {
            "root": {
              "const": "explorer-build"
            },
            "manifest": {
              "$ref": "#/$defs/material"
            },
            "index": {
              "$ref": "#/$defs/material"
            },
            "files": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "algorithm": {
              "const": "sha256-canonical-json-materials-v1"
            },
            "materials": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/material"
              }
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "screenshots"
      ],
      "properties": {
        "receipt": {
          "const": "explorer-runtime-acceptance.json"
        },
        "screenshots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [
            {
              "$ref": "#/$defs/graphScreenshotMaterial"
            },
            {
              "$ref": "#/$defs/runtimeScreenshotMaterial"
            }
          ],
          "items": false
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_transfer",
        "cold_search",
        "warm_search",
        "browser_memory",
        "federation_and_child",
        "graph_relationship_rendering",
        "model_assisted_styling_and_filtering",
        "live_reconciliation_states",
        "facet_count_colour_and_space",
        "cross_browser",
        "keyboard",
        "accessibility"
      ],
      "properties": {
        "startup_transfer": {
          "$ref": "#/$defs/transferGate"
        },
        "cold_search": {
          "$ref": "#/$defs/coldGate"
        },
        "warm_search": {
          "$ref": "#/$defs/warmGate"
        },
        "browser_memory": {
          "$ref": "#/$defs/memoryGate"
        },
        "federation_and_child": {
          "$ref": "#/$defs/passGate"
        },
        "graph_relationship_rendering": {
          "$ref": "#/$defs/passGate"
        },
        "model_assisted_styling_and_filtering": {
          "$ref": "#/$defs/passGate"
        },
        "live_reconciliation_states": {
          "$ref": "#/$defs/passGate"
        },
        "facet_count_colour_and_space": {
          "$ref": "#/$defs/passGate"
        },
        "cross_browser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "required",
            "completed"
          ],
          "properties": {
            "status": {
              "const": "passed"
            },
            "required": {
              "$ref": "#/$defs/browserSet"
            },
            "completed": {
              "$ref": "#/$defs/browserSet"
            }
          }
        },
        "keyboard": {
          "$ref": "#/$defs/passGate"
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "standard"
          ],
          "properties": {
            "status": {
              "const": "passed"
            },
            "standard": {
              "const": "WCAG 2.2 AA"
            }
          }
        }
      }
    },
    "browsers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "failures": {
      "type": "array",
      "maxItems": 0
    },
    "limitations": {
      "type": "array"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f\\u007f\\ud800-\\udfff]+$"
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "graphScreenshotMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "output/playwright/legislation-runtime-graph-chrome.png"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtimeScreenshotMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "output/playwright/legislation-runtime-chrome.png"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "bundle_tree_sha256"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/chris-page-gov/okf-uk-legislation"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bundle_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "explorer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/chris-page-gov/okf-explorer"
        },
        "tag": {
          "const": "v0.5.4"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "browserSet": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "chrome",
          "firefox",
          "webkit"
        ]
      }
    },
    "passGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "passed"
        }
      }
    },
    "passSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks_total",
        "checks_passed",
        "checks_failed",
        "all_passed"
      ],
      "properties": {
        "checks_total": {
          "type": "integer",
          "minimum": 1
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 1
        },
        "checks_failed": {
          "const": 0
        },
        "all_passed": {
          "const": true
        }
      }
    },
    "summaryContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "summary": {
          "$ref": "#/$defs/passSummary"
        }
      }
    },
    "browserValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chrome",
        "firefox",
        "webkit"
      ],
      "properties": {
        "chrome": {
          "type": "number",
          "minimum": 0
        },
        "firefox": {
          "type": "number",
          "minimum": 0
        },
        "webkit": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "transferGate": {
      "type": "object",
      "required": [
        "status",
        "limit_bytes",
        "observed_max_bytes",
        "browser_values"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "limit_bytes": {
          "const": 1048576
        },
        "observed_max_bytes": {
          "type": "integer",
          "maximum": 1048576
        },
        "browser_values": {
          "$ref": "#/$defs/browserValues"
        }
      }
    },
    "coldGate": {
      "type": "object",
      "required": [
        "status",
        "limit_ms",
        "observed_max_ms",
        "browser_values"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "limit_ms": {
          "const": 3000
        },
        "observed_max_ms": {
          "type": "number",
          "maximum": 3000
        },
        "browser_values": {
          "$ref": "#/$defs/browserValues"
        }
      }
    },
    "warmGate": {
      "type": "object",
      "required": [
        "status",
        "limit_ms",
        "observed_max_ms",
        "browser_values"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "limit_ms": {
          "const": 1000
        },
        "observed_max_ms": {
          "type": "number",
          "maximum": 1000
        },
        "browser_values": {
          "$ref": "#/$defs/browserValues"
        }
      }
    },
    "memoryGate": {
      "type": "object",
      "required": [
        "status",
        "limit_bytes",
        "observed_max_bytes"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "limit_bytes": {
          "const": 268435456
        },
        "observed_max_bytes": {
          "type": "integer",
          "maximum": 268435456
        }
      }
    }
  }
}
