{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-uk-legislation/release-assurance/schemas/traceability-closure-receipt.schema.json",
  "title": "Final requirement traceability closure receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "gate",
    "candidate",
    "requirements_total",
    "requirements_closed",
    "unresolved_must_haves",
    "source_ledger",
    "closures",
    "closure_rule"
  ],
  "properties": {
    "schema": {
      "const": "okf-traceability-closure-receipt.v2"
    },
    "status": {
      "const": "passed"
    },
    "gate": {
      "const": "GATE-14"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "requirements_total": {
      "const": 62
    },
    "requirements_closed": {
      "const": 62
    },
    "unresolved_must_haves": {
      "const": 0
    },
    "source_ledger": {
      "$ref": "#/$defs/material"
    },
    "closures": {
      "type": "array",
      "minItems": 62,
      "maxItems": 62,
      "items": {
        "$ref": "#/$defs/closure"
      }
    },
    "closure_rule": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/chris-page-gov/okf-uk-legislation"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "frozen_status",
        "disposition",
        "must_have",
        "rationale",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:P(?:0[1-9]|10)-[0-9]{2}|D-[0-9]{2})$"
        },
        "frozen_status": {
          "enum": [
            "verified",
            "implemented",
            "started",
            "blocked",
            "deferred",
            "superseded"
          ]
        },
        "disposition": {
          "enum": [
            "passed",
            "deferred",
            "blocked",
            "superseded"
          ]
        },
        "must_have": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/material"
          }
        },
        "accepted_exception": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted",
            "authority",
            "decision_evidence"
          ],
          "properties": {
            "accepted": {
              "const": true
            },
            "authority": {
              "type": "string",
              "minLength": 1
            },
            "decision_evidence": {
              "$ref": "#/$defs/material"
            }
          }
        },
        "superseded_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "deferred",
                  "blocked"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "accepted_exception"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "superseded"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "superseded_by"
            ]
          }
        }
      ]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
