{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-uk-legislation/release-assurance/schemas/security-assurance-receipt.schema.json",
  "title": "Frozen-candidate security assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "gate",
    "scan_id",
    "candidate",
    "scan_target",
    "checks",
    "finding_summary",
    "materials",
    "assurance_boundary"
  ],
  "properties": {
    "schema": {
      "const": "okf-security-assurance-receipt.v2"
    },
    "status": {
      "const": "passed"
    },
    "gate": {
      "const": "GATE-10"
    },
    "scan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "scan_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "snapshot_digest"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/chris-page-gov/okf-uk-legislation"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "secrets",
          "dependencies",
          "content-injection",
          "xml-xxe",
          "archive-bomb",
          "ssrf",
          "privacy",
          "unsafe-redirects-and-urls",
          "untrusted-downloaded-content",
          "immutable-evidence",
          "supply-chain"
        ]
      }
    },
    "finding_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportable_total",
        "unresolved_total"
      ],
      "properties": {
        "reportable_total": {
          "const": 0
        },
        "unresolved_total": {
          "const": 0
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/roleMaterial"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "scan_manifest"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "findings"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "coverage"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "report"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "scan_manifest_schema"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "findings_schema"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "coverage_schema"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "artifact_inventory"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "assurance_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/chris-page-gov/okf-uk-legislation"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "roleMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "scan_manifest",
            "findings",
            "coverage",
            "report",
            "scan_manifest_schema",
            "findings_schema",
            "coverage_schema",
            "artifact_inventory"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
